<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#121417">
    <title>ZENIT · Llegá a tu zenit</title>
    <link rel="icon" type="image/png" href="{{favicon}}">
    <link rel="apple-touch-icon" href="{{apple_icon}}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..900;1,14..32,400..900&display=swap">
    <link rel="stylesheet" href="{{base}}/public/css/zenit.css?v={{v}}">
</head>
<body class="{{#pantalla_auth}}sin-menu{{/pantalla_auth}}{{^pantalla_auth}}con-menu{{/pantalla_auth}} {{#modo_juego}}modo-juego{{/modo_juego}} {{#fondo_home}}fondo-home{{/fondo_home}}" data-base="{{base}}">
<!-- Fondo fijo: lobby = categorías (media/fondos/home.jpg) · resto = espacio vacío (media/fondos/espacio.jpg) -->
<div class="fondo" aria-hidden="true" style="background-image: url('{{#fondo_home}}{{fondo_home_url}}{{/fondo_home}}{{^fondo_home}}{{fondo_espacio_url}}{{/fondo_home}}')"></div>

{{^pantalla_auth}}
<!-- ═══ Barra superior ═══ -->
<header class="topbar">
    <a href="{{base}}/" class="logo" aria-label="ZENIT, ir al lobby"><img src="{{logo}}" alt="ZENIT"></a>

    <nav class="nav-escritorio" aria-label="Principal">
        <a href="{{base}}/" class="{{#nav_jugar}}activo{{/nav_jugar}}">Jugar</a>
        <a href="{{base}}/perfil" class="{{#nav_perfil}}activo{{/nav_perfil}}">Perfil</a>
        <a href="{{base}}/ranking" class="{{#nav_ranking}}activo{{/nav_ranking}}">Ranking</a>
        <a href="{{base}}/panel" class="{{#nav_panel}}activo{{/nav_panel}}">Panel</a>
        <a href="{{base}}/zenitplus" class="nav-plus {{#nav_zenitplus}}activo{{/nav_zenitplus}}">ZENIT+</a>
    </nav>

    {{#yo}}
    <div class="topbar-usuario">
        <a href="{{base}}/perfil" class="chip-usuario">
            {{#nivel}}{{> partials/nivel}}{{/nivel}}
            <span class="chip-nombre">{{nombre_usuario}}</span>
            {{> partials/avatar}}
        </a>
    </div>
    {{/yo}}

    {{^yo}}
    <!-- Visitante (sin sesión): botón para entrar + link para registrarse -->
    <div class="topbar-usuario topbar-visitante">
        <a href="{{base}}/login" class="btn btn-primario btn-chico">Iniciá sesión</a>
        <a href="{{base}}/registro" class="link-registro">Crear cuenta</a>
    </div>
    {{/yo}}
</header>

<!-- ═══ Barra inferior (celular) ═══ -->
<nav class="tabbar" aria-label="Principal">
    <a href="{{base}}/" class="{{#nav_jugar}}activo{{/nav_jugar}}">
        <svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg><span>Jugar</span>
    </a>
    <a href="{{base}}/ranking" class="{{#nav_ranking}}activo{{/nav_ranking}}">
        <svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg><span>Ranking</span>
    </a>
    <a href="{{base}}/panel" class="{{#nav_panel}}activo{{/nav_panel}}">
        <svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/></svg><span>Panel</span>
    </a>
    <a href="{{base}}/zenitplus" class="nav-plus {{#nav_zenitplus}}activo{{/nav_zenitplus}}">
        <svg viewBox="0 0 24 24"><path d="M3 7l4.5 4L12 4l4.5 7L21 7l-2 12H5z"/></svg><span>ZENIT+</span>
    </a>
    <a href="{{base}}/perfil" class="{{#nav_perfil}}activo{{/nav_perfil}}">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>Perfil</span>
    </a>
</nav>
{{/pantalla_auth}}

{{#flash}}
<div class="toast toast-{{tipo}}" role="status" data-toast>{{mensaje}}</div>
{{/flash}}

<main class="contenido">
