</main>

<script>
    // Los mensajes flash se ocultan solos a los 4 segundos.
    document.querySelectorAll('[data-toast]').forEach(function (toast) {
        setTimeout(function () { toast.classList.add('toast-saliendo'); }, 4000);
        toast.addEventListener('click', function () { toast.classList.add('toast-saliendo'); });
    });
</script>
