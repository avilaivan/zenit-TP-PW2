<section class="auth auth-registro">
    {{> partials/auth-marca}}

    <div class="auth-panel">
        <div class="card auth-card">
            <p class="sobretitulo">Nueva cuenta</p>
            <h1 class="titulo">Crear cuenta</h1>

            {{#error}}<p class="alerta alerta-error">{{error}}</p>{{/error}}

            {{#form}}
            <form method="post" action="{{base}}/registro/registrar" class="formulario">

                <label class="campo">
                    <span>Nombre completo <small>(lo podés cambiar cuando quieras)</small></span>
                    <input type="text" name="nombre_completo" value="{{nombre_completo}}" minlength="3" maxlength="150"
                           autocomplete="name" placeholder="Nombre y apellido" required autofocus>
                </label>

                <label class="campo">
                    <span>Usuario <small>(único · no se puede cambiar)</small></span>
                    <input type="text" name="nombre_usuario" value="{{nombre_usuario}}" pattern="[A-Za-z0-9_.]{3,20}"
                           maxlength="20" autocomplete="username" required>
                </label>

                <label class="campo">
                    <span>Email <small>(te llega un código para activar la cuenta)</small></span>
                    <input type="email" name="email" value="{{email}}" maxlength="150" autocomplete="email" required>
                </label>

                <div class="fila-2">
                    <label class="campo">
                        <span>Contraseña</span>
                        <input type="password" name="password" minlength="8" autocomplete="new-password" required>
                    </label>
                    <label class="campo">
                        <span>Repetir</span>
                        <input type="password" name="confirmar_password" minlength="8" autocomplete="new-password" required>
                    </label>
                </div>

                <div class="fila-2">
                    <label class="campo">
                        <span>Año de nacimiento</span>
                        <input type="number" name="anio_nacimiento" value="{{anio_nacimiento}}" min="1900" max="2026" placeholder="2001" required>
                    </label>
                    <label class="campo">
                        <span>Sexo</span>
                        <select name="sexo" required>
                            <option value="" disabled {{^sexo}}selected{{/sexo}}>Elegí</option>
                            <option value="masculino" {{#sexo_masculino}}selected{{/sexo_masculino}}>Masculino</option>
                            <option value="femenino" {{#sexo_femenino}}selected{{/sexo_femenino}}>Femenino</option>
                            <option value="no_informa" {{#sexo_no_informa}}selected{{/sexo_no_informa}}>Prefiero no cargarlo</option>
                        </select>
                    </label>
                </div>

                {{> partials/ubicacion}}

                <button type="submit" class="btn btn-primario btn-bloque">Crear cuenta</button>
            </form>
            {{/form}}

            <p class="auth-pie">¿Ya tenés cuenta? <a href="{{base}}/login">Iniciá sesión</a></p>
        </div>
    </div>
</section>

{{> partials/scripts-mapa}}
