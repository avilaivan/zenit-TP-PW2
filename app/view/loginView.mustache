<section class="auth">
    {{> partials/auth-marca}}

    <div class="auth-panel">
        <div class="card auth-card">
            <p class="sobretitulo">Bienvenido de vuelta</p>
            <h1 class="titulo">Iniciar sesión</h1>

            {{#error}}<p class="alerta alerta-error">{{error}}</p>{{/error}}

            <form method="post" action="{{base}}/login/login" class="formulario">
                <label class="campo">
                    <span>Usuario o email</span>
                    <input type="text" name="usuario" value="{{usuario}}" autocomplete="username" required autofocus>
                </label>
                <label class="campo">
                    <span>Contraseña</span>
                    <input type="password" name="password" autocomplete="current-password" required>
                </label>
                <button type="submit" class="btn btn-primario btn-bloque">Entrar</button>
            </form>

            <p class="auth-pie">¿Todavía no tenés cuenta? <a href="{{base}}/registro">Registrate</a></p>
        </div>
    </div>
</section>
