# ══════════════════════════════════════════════════════
# ZENIT · Apache (XAMPP / hosting)
# ══════════════════════════════════════════════════════

# Sin listado de carpetas.
Options -Indexes

DirectoryIndex index.php

# Archivos sensibles: nunca se descargan desde el navegador.
<FilesMatch "\.(ini|log|sql|md|yml)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sin RewriteBase: así funciona igual en http://localhost/ZENIT-TPW2/
    # y en la raíz de un hosting, sin tocar nada.

    # Código interno: solo lo carga index.php. Acceso directo → 403.
    RewriteRule ^(app|helper|vendor|config|log|herramientas)(/|$) - [F,L]

    # Archivos estáticos (css, js, fotos subidas y la carpeta media): se sirven tal cual.
    RewriteRule ^(public|media)/ - [L]

    # Si no es un archivo ni carpeta real, lo resuelve el router:
    #   /perfil/ver?u=demo  →  index.php?controller=perfil&method=ver&u=demo
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/([^/]+)/?$ index.php?controller=$1&method=$2 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/?$ index.php?controller=$1 [L,QSA]
</IfModule>
